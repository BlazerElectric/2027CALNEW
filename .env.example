# ─── Email (Nodemailer / SMTP) ────────────────────────────────────────────────
# SMTP server host (e.g. smtp.gmail.com, smtp.sendgrid.net, etc.)
SMTP_HOST=smtp.gmail.com

# SMTP port — 587 for STARTTLS (most common), 465 for implicit TLS
SMTP_PORT=587

# Set to "true" when using implicit TLS on port 465
SMTP_SECURE=false

# SMTP authentication credentials
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# "From" address for outgoing email (defaults to SMTP_USER if not set)
SMTP_FROM=no-reply@example.com

# Recipient for new-submission notification emails
# Defaults to dferguson@buyblazer.com if not set
NOTIFICATION_EMAIL=dferguson@buyblazer.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Directory where the SQLite database file will be written.
# Defaults to ./data in development and /tmp in production.
# DB_DIR=/custom/path/to/data
